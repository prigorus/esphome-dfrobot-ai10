esphome:
  name: ai10-ci
esp32:
  board: BOARD_NAME
  framework:
    type: esp-idf
logger:
external_components:
  - source:
      type: local
      path: components
uart:
  id: uart_ai10
  tx_pin: GPIO4
  rx_pin: GPIO5
  baud_rate: 115200
  rx_buffer_size: 2048
dfrobot_ai10:
  id: ai10_sensor
  uart_id: uart_ai10
  documented_qr: true
  auto_refresh_users: true
  resume_recognition_after_refresh: true
  on_user_directory:
    then:
      - lambda: 'ESP_LOGI("ci", "directory count=%u", count);'
  on_user_directory_failed:
    then:
      - lambda: 'ESP_LOGI("ci", "directory failed=%u", result);'
  on_recognized:
    then:
      - lambda: 'ESP_LOGI("ci", "uid=%u", uid);'
  on_qr_scanned:
    then:
      - lambda: 'ESP_LOGI("ci", "QR length=%u", (unsigned) qr_data.size());'
  on_enrollment_success:
    then:
      - lambda: 'ESP_LOGI("ci", "uid=%u", uid);'
  on_enrollment_failed:
    then:
      - lambda: 'ESP_LOGI("ci", "result=%u", result);'
  on_recognition_failed:
    then:
      - lambda: 'ESP_LOGI("ci", "result=%u", result);'
  on_command_result:
    then:
      - lambda: 'ESP_LOGI("ci", "command=%u result=%u", command, result);'
  on_user_info:
    then:
      - lambda: 'ESP_LOGI("ci", "uid=%u admin=%d", uid, admin);'
  on_users_received:
    then:
      - lambda: 'ESP_LOGI("ci", "count=%u", count);'
